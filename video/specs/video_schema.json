{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambient-somatic-intelligence.local/video/specs/video_schema.json",
  "title": "Hermes Video Campaign Spec",
  "type": "object",
  "required": [
    "title",
    "subtitle",
    "category",
    "target_audience",
    "cta",
    "platform",
    "duration_seconds",
    "aspect_ratio",
    "composition_template"
  ],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string"},
    "category": {"type": "string"},
    "target_audience": {"type": "string"},
    "cta": {"type": "string"},
    "platform": {"type": "string", "enum": ["LinkedIn", "X", "Blogger", "YouTube", "Instagram"]},
    "duration_seconds": {"type": "integer", "minimum": 15, "maximum": 90},
    "aspect_ratio": {"type": "string", "enum": ["1:1", "9:16", "16:9"]},
    "composition_template": {
      "type": "string",
      "enum": [
        "linkedin-thought-leadership",
        "ebook-promo",
        "system-explainer",
        "documentary-narrative"
      ]
    },
    "hook": {"type": "string"},
    "script_markdown": {"type": "string"},
    "storyboard_markdown": {"type": "string"},
    "design_markdown": {"type": "string"},
    "assets": {
      "type": "object",
      "properties": {
        "cover_image": {"type": "string"},
        "logo_image": {"type": "string"},
        "audio_track": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
