<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.ambient-os.dmn-tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>-B</string>
    <string>/Users/alicken/ambient-os/scripts/dmn_tick_loop.py</string>
    <string>--interval</string>
    <string>60</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/alicken/ambient-os</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AMBIENT_OS_ROOT</key>
    <string>/Users/alicken/ambient-os</string>
    <key>HERMES_HOME</key>
    <string>/Users/alicken/.hermes</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/alicken/ambient-os/logs/dmn_tick_loop.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/alicken/ambient-os/logs/dmn_tick_loop.err.log</string>
</dict>
</plist>
